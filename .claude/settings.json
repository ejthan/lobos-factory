{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/packages/factory-core/hooks/protect-factory-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/packages/factory-core/hooks/protect-main.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/packages/factory-core/hooks/stop-gate.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "factory-core@lobos-local": true
  },
  "extraKnownMarketplaces": {
    "lobos-local": {
      "source": {
        "source": "directory",
        "path": "./packages"
      }
    }
  }
}
